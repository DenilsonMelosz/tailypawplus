# Copie para .env só se for rodar com Postgres local/Neon. Sem DATABASE_URL, a API usa um banco embutido (pasta .data).
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio
# Endereço do site na Vercel (vários separados por vírgula). Vazio = aceita qualquer origem.
CORS_ORIGIN=https://tailypawplus.vercel.app
# Prazos do ciclo de vida do alerta (RN05/RN06). Para demonstrar na apresentação use LIFECYCLE_UNIT=minutes.
LIFECYCLE_UNIT=days
LIFECYCLE_CONFIRM=5
LIFECYCLE_ARCHIVE=5
